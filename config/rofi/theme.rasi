* {
    bg:       #1e1e2e;
    bg-alt:   #313244;
    fg:       #cdd6f4;
    fg-alt:   #a6adc8;
    accent:   #89b4fa;
    urgent:   #f38ba8;
    background-color: transparent;
    text-color: @fg;
}
window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    width: 40%;
    padding: 16px;
}
inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; font: "JetBrainsMono Nerd Font Bold 11"; }
entry  { placeholder: "type to filter…"; placeholder-color: @fg-alt; }
listview {
    lines: 10;
    spacing: 4px;
    padding: 12px 0 0 0;
    scrollbar: true;
}
scrollbar { handle-color: @accent; handle-width: 4px; border-radius: 4px; }
element { padding: 8px 12px; border-radius: 8px; }
element normal normal   { text-color: @fg; }
element alternate normal{ text-color: @fg; }
element selected normal { background-color: @accent; text-color: @bg; }
element urgent  normal  { text-color: @urgent; }
element-icon { size: 20px; padding: 0 10px 0 0; }
element-text { vertical-align: 0.5; }
