/**
 * =============================================================================
 * Material 3 Expressive Theme for Rofi
 * Seamlessly paired with Quickshell & Dynamic Wallpaper Matugen Palettes
 * =============================================================================
 */

@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @on-surface;
    margin: 0px;
    padding: 0px;
}

window {
    background-color: @surface-container;
    border: 1px solid;
    border-color: @outline-variant;
    border-radius: 28px;
    width: 48%;
    padding: 22px;
}

mainbox {
    spacing: 16px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @surface-container-high;
    border: 1px solid;
    border-color: @outline-variant;
    border-radius: 9999px;
    padding: 10px 20px;
    spacing: 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @primary;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    text-color: @on-surface;
    placeholder-color: @on-surface-variant;
    placeholder: "Type to search…";
    cursor: text;
}

message {
    background-color: @surface-container-highest;
    border-radius: 16px;
    padding: 12px 16px;
}

textbox {
    text-color: @on-surface;
}

listview {
    lines: 10;
    columns: 1;
    spacing: 6px;
    cycle: true;
    dynamic: true;
    scrollbar: true;
}

scrollbar {
    handle-width: 4px;
    handle-color: @primary;
    border-radius: 4px;
    background-color: @surface-container-high;
}

element {
    padding: 10px 16px;
    border-radius: 16px;
    spacing: 12px;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @on-surface;
}

element alternate.normal {
    background-color: transparent;
    text-color: @on-surface;
}

element selected.normal {
    background-color: @primary-container;
    text-color: @on-primary-container;
    border: 1px solid;
    border-color: @primary;
}

element-icon {
    size: 24px;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
    font: "JetBrainsMono Nerd Font Medium 11";
}
