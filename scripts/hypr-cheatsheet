#!/usr/bin/env bash
# Render every keybinding into a clean, searchable cheatsheet overlay.
set -euo pipefail

BINDS="$HOME/.config/hypr/conf.d/binds.conf"
SUBMAPS="$HOME/.config/hypr/conf.d/submaps.conf"

format_desc() {
  local disp="$1"
  local args="$2"
  case "$disp $args" in
    *"quickshell:searchToggle"*) echo "App Launcher & Command Search" ;;
    *"quickshell:overviewToggle"* | *"quickshell:overviewWorkspacesToggle"*) echo "Workspace & Window Overview" ;;
    *"quickshell:settingsToggle"*) echo "Settings Panel (end4-pC)" ;;
    *"quickshell:sidebarRightToggle"*) echo "Notification Center & Quick Toggles" ;;
    *"quickshell:sidebarLeftToggle"*) echo "AI Assistant & Left Sidebar" ;;
    *"quickshell:sessionToggle"*) echo "Session & Power Menu (Lock/Exit/Shutdown)" ;;
    *"quickshell:wallpaperSelectorToggle"*) echo "Wallpaper Selector" ;;
    *"quickshell:wallpaperSelectorRandom"*) echo "Select Random Wallpaper" ;;
    *"terminal"* | *"ghostty"*) echo "Launch Terminal (Ghostty)" ;;
    *"firefox"* | *"browser"*) echo "Launch Web Browser (Firefox)" ;;
    *"nautilus"*) echo "Launch File Manager (Nautilus)" ;;
    *"rofi -show drun"*) echo "Alternative App Launcher (Rofi)" ;;
    *"rofi -show window"*) echo "Switch Window by Name" ;;
    *"hypr-cheatsheet"*) echo "Show Keybinding Cheatsheet" ;;
    *"hypr-wifi"*) echo "Wi-Fi Networks Menu" ;;
    *"hypr-bluetooth"*) echo "Bluetooth Devices Menu" ;;
    *"hypr-power"*) echo "Power Profile Selector" ;;
    *"hypr-clipboard"*) echo "Clipboard History Picker" ;;
    *"wdisplays"*) echo "Display & Monitor Settings" ;;
    *"hyprpicker"*) echo "Color Picker (Hex to Clipboard)" ;;
    *"pavucontrol"*) echo "Volume Mixer (GUI)" ;;
    *"hyprlock"*) echo "Lock Screen" ;;
    *"killactive"*) echo "Close Active Window" ;;
    *"cyclenext"*) echo "Cycle Next Window" ;;
    *"bringactivetotop"*) echo "Bring Window to Top" ;;
    *"togglefloating"*) echo "Toggle Floating / Tiled Window" ;;
    *"fullscreen 0"*) echo "Toggle Fullscreen Mode" ;;
    *"fullscreen 1"*) echo "Toggle Fake Fullscreen" ;;
    *"exit"*) echo "Exit Hyprland (Logout)" ;;
    *"movefocus l"* | *"movefocus, l"*) echo "Focus Left Window" ;;
    *"movefocus r"* | *"movefocus, r"*) echo "Focus Right Window" ;;
    *"movefocus u"* | *"movefocus, u"*) echo "Focus Upper Window" ;;
    *"movefocus d"* | *"movefocus, d"*) echo "Focus Lower Window" ;;
    *"swapwindow l"* | *"swapwindow, l"*) echo "Swap Window to the Left" ;;
    *"swapwindow r"* | *"swapwindow, r"*) echo "Swap Window to the Right" ;;
    *"swapwindow u"* | *"swapwindow, u"*) echo "Swap Window Upwards" ;;
    *"swapwindow d"* | *"swapwindow, d"*) echo "Swap Window Downwards" ;;
    *"submap resize"*) echo "Enter Window Resize Mode" ;;
    *"submap move"*) echo "Enter Window Move Mode" ;;
    *"special:scratch"* | *"special, scratch"*) echo "Toggle / Send to Scratchpad" ;;
    *"movetoworkspace"*) echo "Move Window to Workspace $args" ;;
    *"workspace previous"* | *"workspace, previous"*) echo "Switch to Previous Workspace" ;;
    *"workspace"*) echo "Switch to Workspace $args" ;;
    *"grim"*"slurp"*) echo "Interactive Region Screenshot (Clipboard)" ;;
    *"grim"*) echo "Fullscreen Screenshot" ;;
    *"pamixer -i"*) echo "Volume Up 5%" ;;
    *"pamixer -d"*) echo "Volume Down 5%" ;;
    *"pamixer -t"*) echo "Toggle Audio Mute" ;;
    *"brightnessctl set 5%+"*) echo "Screen Brightness Up 5%" ;;
    *"brightnessctl set 5%-"*) echo "Screen Brightness Down 5%" ;;
    *"playerctl play-pause"*) echo "Media: Play / Pause" ;;
    *"playerctl next"*) echo "Media: Next Track" ;;
    *"playerctl previous"*) echo "Media: Previous Track" ;;
    *) echo "$disp $args" ;;
  esac
}

parse() {
  grep -hE '^\s*bind[a-z]*\s*=' "$@" 2>/dev/null | while IFS= read -r line; do
    body="${line#*=}"
    mods="$(echo "$body"  | awk -F',' '{print $1}' | xargs)"
    key="$(echo "$body"   | awk -F',' '{print $2}' | xargs)"
    disp="$(echo "$body"  | awk -F',' '{print $3}' | xargs)"
    args="$(echo "$body"  | cut -d',' -f4- | xargs)"
    [ -z "$key" ] && continue

    key_disp="$key"
    case "$key" in
      slash) key_disp="/" ;;
      space) key_disp="Space" ;;
      Escape) key_disp="Esc" ;;
      BackSpace) key_disp="Backspace" ;;
      grave) key_disp="~ (\`)" ;;
      comma) key_disp="," ;;
      equal) key_disp="+" ;;
      minus) key_disp="-" ;;
      Left) key_disp="Left (←)" ;;
      Right) key_disp="Right (→)" ;;
      Up) key_disp="Up (↑)" ;;
      Down) key_disp="Down (↓)" ;;
      Super_L) key_disp="Super (tap)" ;;
      Return) key_disp="Enter" ;;
    esac
    
    # Clean up modifiers for readability
    if [ "$key" = "Super_L" ]; then
      combo="SUPER (tap)"
    else
      combo="$([ -n "$mods" ] && echo "$mods + $key_disp" || echo "$key_disp")"
      combo="${combo//\$mainMod/SUPER}"
    fi
    
    ACCENT="$(grep -E '^\s*primary:' "$HOME/.config/rofi/colors.rasi" 2>/dev/null | awk '{print $2}' | tr -d ';' || echo "#e4b7f3")"
    [ -z "$ACCENT" ] && ACCENT="#e4b7f3"
    
    desc="$(format_desc "$disp" "$args")"
    printf '<b>%-30s</b>  <span color="%s">│</span>  %s\n' "$combo" "$ACCENT" "$desc"
  done
}

ACCENT="$(grep -E '^\s*primary:' "$HOME/.config/rofi/colors.rasi" 2>/dev/null | awk '{print $2}' | tr -d ';' || echo "#e4b7f3")"
[ -z "$ACCENT" ] && ACCENT="#e4b7f3"

{
  echo "<span color=\"$ACCENT\" weight=\"bold\">─── SHELL &amp; APPLICATION SHORTCUTS ───</span>"
  parse "$BINDS"
  if [ -e "$SUBMAPS" ]; then
    echo ""
    echo "<span color=\"$ACCENT\" weight=\"bold\">─── MODAL NAVIGATION (SUBMAPS) ───</span>"
    parse "$SUBMAPS"
  fi
} | rofi -dmenu -i -markup-rows -no-custom \
         -p "⌨ Keybinds" \
         -theme-str 'window { width: 58%; } listview { lines: 16; }' \
  >/dev/null 2>&1 || true
