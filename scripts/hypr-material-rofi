#!/usr/bin/env python3
"""
Generate Material 3 colors.rasi for Rofi dynamically from Quickshell's Material You colors.json
"""
import json
import os
import sys

def main():
    state_dir = os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))
    config_dir = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
    
    colors_json = os.path.join(state_dir, "quickshell", "user", "generated", "colors.json")
    if not os.path.exists(colors_json):
        sys.exit(0)

    try:
        with open(colors_json, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        sys.exit(1)

    is_dark = data.get("is_dark_mode", True)
    mode = "dark" if is_dark else "light"
    colors = data.get("colors", {})

    def get_col(name, fallback="#ffffff"):
        return colors.get(name, {}).get(mode, {}).get("color", fallback)

    content = f"""/**
 * Material 3 Dynamic Palette for Rofi
 * Auto-generated by hypr-material-rofi from active wallpaper
 */

* {{
    primary:                    {get_col("primary", "#e4b7f3")};
    on-primary:                 {get_col("on_primary", "#442253")};
    primary-container:          {get_col("primary_container", "#5d386b")};
    on-primary-container:       {get_col("on_primary_container", "#f8d8ff")};
    secondary:                  {get_col("secondary", "#d4c0d7")};
    on-secondary:               {get_col("on_secondary", "#392c3d")};
    secondary-container:        {get_col("secondary_container", "#504255")};
    on-secondary-container:     {get_col("on_secondary_container", "#f1dcf4")};
    surface:                    {get_col("surface", "#161217")};
    surface-container:          {get_col("surface_container", "#231e23")};
    surface-container-high:     {get_col("surface_container_high", "#2d282e")};
    surface-container-highest:  {get_col("surface_container_highest", "#383339")};
    on-surface:                 {get_col("on_surface", "#e9e0e7")};
    on-surface-variant:         {get_col("on_surface_variant", "#cec3cd")};
    outline:                    {get_col("outline", "#978e97")};
    outline-variant:            {get_col("outline_variant", "#4c444d")};
    error:                      {get_col("error", "#ffb4ab")};
    on-error:                   {get_col("on_error", "#690005")};
}}
"""
    rofi_colors = os.path.join(config_dir, "rofi", "colors.rasi")
    try:
        os.makedirs(os.path.dirname(rofi_colors), exist_ok=True)
        with open(rofi_colors, "w", encoding="utf-8") as f:
            f.write(content)
    except Exception:
        pass

if __name__ == "__main__":
    main()
