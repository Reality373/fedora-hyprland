#!/usr/bin/env bash
# Clipboard history. Selectable by keyboard (type to filter, Enter) or mouse.
set -euo pipefail

SELECTION="$(cliphist list | rofi -dmenu -i -p "📋 Clipboard" \
             -theme-str 'window { width: 52%; } listview { lines: 12; }')" || exit 0
[ -z "$SELECTION" ] && exit 0
printf '%s' "$SELECTION" | cliphist decode | wl-copy
